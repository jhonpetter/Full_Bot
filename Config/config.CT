    <CheatEntry>
      <ID>570</ID>
      <Description>"Auto Assemble script"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
alloc(newmem, 256)
label(exit)
label(szCloseCmd)

createthread(newmem)

newmem:
  // 1. Navega pela cadeia de ponteiros até CECGameUIMan: [[[00E39F5C]+1C]+14]+8
  mov eax, [00E39F5C]
  test eax, eax
  je exit

  mov eax, [eax+1C]
  test eax, eax
  je exit

  mov eax, [eax+14]
  test eax, eax
  je exit

  mov eax, [eax+08]
  test eax, eax
  je exit

  // 2. Obtém o ponteiro da janela ativa atual em +0x450
  mov ecx, [eax+450]
  test ecx, ecx
  je exit

  // 3. Verifica se a janela está visível (+0x90 == 1)
  cmp byte ptr [ecx+90], 1
  jne exit

  // 4. Chama a função virtual [VTable + 0x34] passando "Btn_Close"
  mov eax, [ecx]
  push szCloseCmd
  call dword ptr [eax+34]

exit:
  ret

szCloseCmd:
  db 'Btn_Close', 0

[DISABLE]
dealloc(newmem)

</AssemblerScript>
    </CheatEntry>
