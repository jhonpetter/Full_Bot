  </Structures>
  <LuaScript>local pBase       = readInteger(0x00E39F5C)
local pGame       = pBase and readInteger(pBase + 0x1C)
local pPlayer     = pGame and readInteger(pGame + 0x2C)
local pSkillArray = pPlayer and readInteger(pPlayer + 0x150C)
local qtdSkills   = pPlayer and readInteger(pPlayer + 0x1510) or 0

print("ID   | +1C | +20 | +24 | +28 | +2C | +30 | +34 | +38 | +3C | +40 | +44 | +48 | +4C | +50")
print("------------------------------------------------------------------------------------------")

for i = 0, qtdSkills - 1 do
    local pCECSkill = readInteger(pSkillArray + (i * 4))
    if pCECSkill and pCECSkill ~= 0 then
        local id = readInteger(pCECSkill + 0x08)
        local pInternal = readInteger(pCECSkill + 0x04)
        local pStub = pInternal and readInteger(pInternal + 0x04)

        if pStub and pStub ~= 0 then
            local linha = string.format("%4d |", id)
            for off = 0x1C, 0x50, 4 do
                local val = readInteger(pStub + off) or 0
                -- Exibe valores pequenos (enumerações) e coloca '.' se for ponteiro grande
                if val &gt;= 0 and val &lt;= 20 then
                    linha = linha .. string.format(" %2d  |", val)
                else
                    linha = linha .. "  .  |"
                end
            end
            print(linha)
        end
    end
end

</LuaScript>
</CheatTable>
